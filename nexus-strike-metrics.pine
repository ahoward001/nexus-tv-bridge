//@version=5
// =============================================================================
// Nexus Strike Metrics for Nexus → TradingView Bridge 6.12.1.11
// -----------------------------------------------------------------------------
// Companion to the "Nexus Futures V3" indicator. That one draws Nexus's own
// curated walls from the encoded export string; it can't take anything else.
// This one takes a plain list of prices, so the Bridge extension can drop in the
// significant per-strike levels the export leaves out (and you can type them by
// hand to test).
//
// Run BOTH indicators on the chart — this one only adds lines, it replaces
// nothing.
//
// INPUT FORMAT   price:type:score:oi:gex:line:color   comma separated, spaces ignored
//   price  required   e.g. 690  or  690.5
//   type   optional   R = resistance   S = support   default R (kept for the feed)
//   score  optional   bubble 1 — the NUMBER is tinted with Nexus's own score color
//                      (field 7, blue->orange->red); low scores fade smoothly, no cliff.
//   oi     optional   OI Neto, bubble 2 — text green if +, red if -
//   gex    optional   GEX,     bubble 3 — text green if +, red if -
//   line   optional   "1" = draw the dotted line, "0" = bubbles only (default 1).
//                      Bridge sets 1 only on significant strikes the export omits.
//   color  optional   Nexus's own score-number color "r-g-b-a"; paints the score
//                      TEXT (and the line). Absent -> falls back to a score gradient.
//
//   690:R:38:+2.1K:+313.2K:1:244-63-94-19, 685:R:72:-24.2K:-435.2M:0
//   690, 694, 700                     (bare prices also work — just a line)
// =============================================================================

indicator("Nexus Strike Metrics", overlay = true, max_lines_count = 200, max_labels_count = 300)

// ---- inputs -----------------------------------------------------------------
// display.none keeps this (very long) value OUT of the chart legend / status line.
// Without it TradingView echoes the whole strike-metrics string across the top of the
// chart. It stays fully readable/writable in the Settings dialog, so the extension is
// unaffected.
src = input.string("", "Strike metrics", display = display.none, tooltip =
     "price:type:score:oi:gex:line, comma separated\n" +
     "e.g.  690:R:38:+2.1K:+313.2K:1\n" +
     "score / oi / gex each get their own bubble; colors are automatic")

enabled    = input.bool(true, "Show key levels", group = "Style",
     tooltip = "Master on/off for the WHOLE indicator (lines + bubbles). The eye toggle under the " +
     "floating Bridge button flips this checkbox.")
showLabels = input.bool(true,  "Show labels",  group = "Style")
// Per-column switches. Hiding a column also REMOVES ITS SLOT — the remaining
// columns shift left to close the gap, rather than leaving a hole where it was.
showScore  = input.bool(true, "Column: Score", group = "Columns")
showOi     = input.bool(true, "Column: OI",    group = "Columns")
showGex    = input.bool(true, "Column: GEX",   group = "Columns")
// Added 2026-09-23. Default OFF: an existing chart looks exactly as it did until ticked.
showDex    = input.bool(false, "Column: DEX", group = "Columns",
     tooltip = "Net dealer delta at this strike. GEX says how hard dealers defend the level; " +
     "DEX says which way they are already leaning into it.")
showShare  = input.bool(false, "Column: % of board", group = "Columns",
     tooltip = "This strike's |GEX| as a share of the whole board. The best single predictor of " +
     "whether a level holds: under 3% of the board held 31% of the time, 25%+ held 80%.")
showVol    = input.bool(false, "Column: Net vol (today)", group = "Columns",
     tooltip = "Net volume traded at this strike TODAY. Open interest is last night's print, so a " +
     "strike that only came alive today is invisible in OI — this is the column that shows it.")
// ---- gravity ----------------------------------------------------------------
// The active gravity level, written in by the extension. It lives on its own Nexus tab
// and moves a handful of times a session, so it is read on a long interval rather than
// on every sync, and there is a reload button beside it on the floating panel.
showGrav   = input.bool(true, "Show gravity level", group = "Gravity",
     tooltip = "A bold line at Nexus's ACTIVE gravity level, with an arrow showing which way it " +
     "is pulling from here and how long it has held.")
gravCol    = input.color(#00A3FF, "Gravity color", group = "Gravity")
// display.none on the two numeric gravity inputs as well: TradingView prints every
// numeric input into the legend, so these were showing up as a bare "3 3" beside the
// indicator name with nothing to say what they were.
gravWidth  = input.int(3, "Gravity line width", minval = 1, maxval = 8, group = "Gravity", display = display.none,
     tooltip = "Deliberately heavier than the strike lines — it is one level, not one of twenty.")
gravLabOff = input.int(3, "Gravity label offset (bars right)", minval = 0, maxval = 80, group = "Gravity", display = display.none)
showReach  = input.bool(true, "Mark the reach target", group = "Gravity",
     tooltip = "Nexus's highest-touch-probability level, drawn thin and dashed. This is what the " +
     "gravity arrow points AT: gravity says where the pull is, reach says where it most likely goes.")
// display.none for the same reason the strike string uses it: without it TradingView
// prints the whole raw value ("736:DOMINANT STRUCTURE:60:742:10") into the chart legend.
gravData   = input.string("", "Gravity data", group = "Gravity", display = display.none,
     tooltip = "Filled by the extension: level:classification:touch%:target:minutes-held. " +
     "Leave it alone unless you are testing by hand.")
showAge    = input.bool(false, "Column: Age", group = "Columns",
     tooltip = "How long this strike has been big (>=10% of the board). N = new (<30 min), " +
     "S = settling, E = established (2h+). Big for 2h+ won 48% of the time in the bounce study; " +
     "big for under 30 min, 24%. Measured against continuous samples, the badge is right ~95% at a " +
     "15-minute sync cadence and only ever errs YOUNG.")
labelSizeI = input.string("Normal", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = "Style",
     tooltip = "One size for every row. Emphasis comes from color (key levels get colored boxes), not size.")
sizeNum    = input.int(3, "Size override (buttons)", minval = 0, maxval = 5, group = "Style",
     tooltip = "0 = use the Label size dropdown above. 1-5 = Tiny / Small / Normal / Large / Huge. " +
     "The bigger/smaller buttons under the floating Bridge button drive this field.")
heavyFont  = input.bool(true, "Heavier font (monospace)", group = "Style",
     tooltip = "Pine labels can't be bold (no font-weight exists), so this swaps in the monospace font, which " +
     "renders chunkier/heavier than the default — the closest thing to bold available. Also lines the columns up. Turn off for the default font.")
labelOff   = input.int(44, "Label offset (bars right)", minval = 0, maxval = 120, group = "Style",
     tooltip = "Push the first bubble this many bars right of the last candle. " +
     "36 = 3 hours out on a 5-min chart. Very large values can fall off behind the price scale.")
bubbleGap  = input.int(15, "Bubble spacing (bars)", minval = 2, maxval = 40, group = "Style",
     tooltip = "Gap between the score / OI / GEX columns. Labels are fixed pixel width but " +
     "spaced in bars, so nudge this if they overlap or spread out at your usual zoom.")
labelPosI  = input.string("Above", "Label float", options = ["Above", "Below", "Up-right", "Down-right"], group = "Style",
     tooltip = "Where the bubble sits vs its level. 'Above' puts it over the level with the pointer pointing DOWN to it.")
lineWidth  = input.int(2, "Line width", minval = 1, maxval = 4, group = "Style")

// THE DRAW ORDER, as a comma-separated list of column keys. The extension writes this
// from the Options page; you can also type it here. A key that is missing keeps its
// default position, and an unknown key is ignored — so a typo can never make a column
// disappear, it just leaves the order alone.
colOrder   = input.string("score,oi,gex,dex,share,vol,age", "Column order", group = "Columns",
     display = display.none,
     tooltip = "Left to right. Keys: score, oi, gex, dex, share, vol, age.")

// Overall brightness. Rides ON TOP of the individual transparency inputs below
// rather than replacing them, so any tuning you have done there survives. 0 = as
// configured; higher = everything progressively more see-through.
fadeAll    = input.int(0, "Overall brightness (%)", minval = -80, maxval = 80, group = "Style",
     tooltip = "One control for the whole overlay, centred on 0. 0 keeps the colours exactly as set below; " +
     "POSITIVE fades everything toward invisible; NEGATIVE pushes everything toward solid. Both directions are " +
     "proportional, so the relative weighting that makes big levels read heavier than small ones survives either way.")

// The Score column sits a FIXED fraction of a gap closer to OI. Not an input:
// it corrects a visual imbalance rather than expressing a preference. Score
// bubbles hold 1-2 characters while OI/GEX hold things like "-29.4M", so an
// identical bar gap leaves visibly more whitespace after Score. Shifting it right
// by a quarter gap makes the three columns *look* evenly spaced, which is the
// thing that actually matters.
SCORE_NUDGE = 0.25
// GEX comes back in by a smaller fraction, for the mirror-image reason: OI's own
// labels are wide ("+8.7K"), so the whitespace between OI and GEX reads larger than
// the gap before it even though the bar spacing is identical. Also not an input —
// same argument as above, it corrects an imbalance rather than expressing taste.
// Both nudges are fractions of `bubbleGap`, so they scale with the spacing slider
// instead of drifting out of proportion when you widen the columns.
GEX_NUDGE = -0.08
// %BD holds "1%" or "16%" against OI/GEX/DEX's "-29.4M", so at a uniform lane width it
// floats in whitespace and reads detached from the block it belongs to. Nudging it sideways
// doesn't fix that — it just moves the hole to the other side. What it needs is a NARROWER
// LANE, so the column after it starts sooner and the whole block tightens up. 0.62 is the
// rough width ratio of "16%" to "-29.4M" at the same font.
//
// This is why `slot` is a float: advancing it by a fraction is the whole mechanism. Every
// offset is rounded at the point of use, because drawBubble takes bar offsets as ints.
SHARE_SLOT = 0.62
// Whole bars, not a fraction: this is compensating for a fixed pixel effect (label width),
// not for anything that scales with column spacing.
//
// The score bubble keeps the SAME pointer as OI and GEX — bottom-left corner — so all three
// look alike; only its POSITION is nudged. It was briefly centred (4.6.3) to line it up with
// its header, but that changed the shape of the pointer too, which was not the ask. Dropped
// from 2 bars to 1 because a corner-anchored box sits about half its own width right of
// where a centred one does, and the score box is only one or two characters wide.
SCORE_BUMP = 1
lineStyleI = input.string("Dashed", "Line style", options = ["Solid", "Dashed", "Dotted"], group = "Style")
// A DISPUTED GAMMA FLIP GETS ITS OWN COLOUR, because it does not mean what the other
// lines mean. Every other line says "this strike is significant". This one says "the
// chart you are looking at is out of date" — the dashboard's card has moved the flip and
// the export Nexus draws from has not caught up yet. Different claim, different colour.
flipCol    = input.color(#b14cff, "Disputed Gamma Flip", group = "Style",
     tooltip = "Drawn when the Gamma Flip on the Nexus card disagrees with the one in the export " +
     "the chart is drawn from. It marks the CARD's price — the newer of the two.")
spanFull   = input.bool(true, "Span full width", group = "Style",
     tooltip = "Extend each level line all the way across the chart. Off = just a tick at the level.")

// ---- colors -----------------------------------------------------------------
colScoreT = input.color(color.black, "Bubble text", group = "Colors",
     tooltip = "Text color for all three bubbles. Black reads cleanly on both the gray (minor) and the colored (key-level) boxes.")
colGray   = input.color(#868b93, "Bubble background",  group = "Colors")
// OI/GEX get a CONTINUOUS lightness ramp within their sign, not just an opacity fade.
// Opacity alone is a weak visual channel, which is why small values still read "dark";
// pale -> saturated -> deep carries magnitude far better and matches the score ramp.
colPosLo  = input.color(#cdefc4, "OI/GEX +  low  (pale green)",  group = "Colors")
colPos    = input.color(#45b681, "OI/GEX +  mid  (green)",       group = "Colors")
colPosHi  = input.color(#297a46, "OI/GEX +  high (deep green)", group = "Colors")
colNegLo  = input.color(#ffe0de, "OI/GEX -  low  (pale pink)",  group = "Colors")
colNeg    = input.color(#ef5350, "OI/GEX -  mid  (red)",        group = "Colors")
colNegHi  = input.color(#7f1d1d, "OI/GEX -  high (deep maroon)",group = "Colors")
// ONE continuous warm ramp for the score — light yellow -> yellow -> light orange ->
// orange -> dark orange -> red -> burgundy. Three hard bands + a blue-gray floor read as
// unrelated colors ("purple to yellow to red, doesn't feel like one scale"); a single
// hue ramp reads as one axis, so the eye ranks levels instantly.
colSc1 = input.color(#f0d96b, "Score 1 — light yellow", group = "Colors")
colSc2 = input.color(#ffc51f, "Score 2 — yellow",       group = "Colors")
colSc3 = input.color(#ffbe3d, "Score 3 — light orange", group = "Colors")
colSc4 = input.color(#ff9416, "Score 4 — orange",       group = "Colors")
colSc5 = input.color(#ef6c00, "Score 5 — dark orange",  group = "Colors")
colSc6 = input.color(#d32f2f, "Score 6 — red",          group = "Colors")
colSc7 = input.color(#7f1d1d, "Score 7 — burgundy",     group = "Colors")
topScore  = input.int(70, "Score for darkest box", minval = 5, group = "Colors",
     tooltip = "Score that reaches the DARKEST/most-solid box. Set this near your biggest wall scores " +
     "(~55-65) so the gradient keeps deepening across the whole range instead of flattening out early — " +
     "that's what makes the really-important levels stand out as the darkest.")
darkT     = input.int(0, "Darkest box (transp %)", minval = 0, maxval = 40, group = "Colors",
     tooltip = "Transparency of the box at the top score. Low = near-solid, so top levels read as solid chips " +
     "against the translucent crowd. This solidity is the standout for the important levels.")
scoreMax  = input.int(55, "Score scale (reddest)", minval = 1, group = "Colors",
     tooltip = "Fallback only: for manual entries with no Nexus color, the score box runs " +
     "yellow up to red at this score. Bridge levels use Nexus's own score color.")
insigFade = input.int(78, "Insignificant fade (%)", minval = 40, maxval = 95, group = "Colors",
     tooltip = "Faintness of the box at the BOTTOM of the scale (heat 0). Higher = fainter small values. " +
     "Lower this if the whole column reads too washed out.")
midT      = input.int(42, "Mid-heat transp (%)", minval = 20, maxval = 80, group = "Colors",
     tooltip = "OI/GEX opacity at the HALFWAY point (heat 50). Below 50 stays muted (never the glaring " +
     "solid color); above 50 ramps toward solid. Raise to keep more values muted.")
heatCurve = input.float(1.0, "Heat curve (1 = linear)", minval = 0.3, maxval = 1.0, step = 0.05, group = "Colors",
     tooltip = "Bends the magnitude scale so MID-SIZE values still read bold. Everything is scaled to the " +
     "session's single biggest OI/GEX, so with a linear curve (1.0) one monster wall makes everything else " +
     "faint. 0.5 = square root: a value at 25% of the max reads at 50% intensity. Lower = punchier.")
showTitle = input.bool(true, "Show header row", group = "Colors")
hdrGapPct = input.float(6.5, "Header gap (% of range)", minval = 1.0, maxval = 25.0, step = 0.5, group = "Colors",
     tooltip = "Vertical distance from the top level up to the header row, as a % of the drawn price range. " +
     "Lower = headers sit closer to the levels.")
hdrShift  = input.float(2.33, "Header nudge (bars)", minval = -10, maxval = 10, step = 0.1, group = "Colors",
     tooltip = "Headers use a straight-DOWN tail, which centres the chip on its anchor, while the data " +
     "bubbles anchor a corner. This nudges the header right so it sits over its column. Pine can't measure " +
     "label width, so tune this by eye if your label size or font changes. 2.33 is what looked " +
     "right at Normal size; the stepper moves in 0.1 but you can type any value.")
colHdrBg  = input.color(#525762, "Header bar", group = "Colors")
colHdrTx  = input.color(#aae28d, "Header text", group = "Colors")

// ---- helpers ----------------------------------------------------------------
styleOf(s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

sizeOf(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge

// Map the 1-5 numeric size override (driven by the FAB buttons) to a size name.
numToName(n) =>
    n == 1 ? "Tiny" : n == 2 ? "Small" : n == 3 ? "Normal" : n == 4 ? "Large" : "Huge"

// Effective size name: the override (buttons) when set, else the dropdown.
effSz = sizeNum > 0 ? numToName(sizeNum) : labelSizeI

// TradingView names label styles after the POINTER direction; the box floats the
// OPPOSITE way. So a box that floats DOWN-RIGHT needs the pointer pointing
// UP-LEFT (style_label_upper_left), etc. This maps plain box-direction names to
// the right style so the input reads the way the eye sees it.
labelStyleOf(s) =>
    s == "Above"     ? label.style_label_lower_left :
     s == "Below"    ? label.style_label_up :
     s == "Up-right" ? label.style_label_lower_right :
     label.style_label_upper_left

// Once a box gets dark (deep green / maroon / burgundy), black text disappears — flip the
// label to white past that point so the top levels stay readable.
txtOn(isDark) =>
    isDark ? color.white : colScoreT

// Signed value + its 0-1 heat -> a continuous colour on that sign's ramp.
// Sign picks the family (green vs red); heat drives pale -> saturated -> deep.
signGrad(v, h) =>
    pos = not str.startswith(v, "-")
    cLo = pos ? colPosLo : colNegLo
    cMid = pos ? colPos : colNeg
    cHi = pos ? colPosHi : colNegHi
    hc = math.max(0.0, math.min(1.0, h))
    hc < 0.5 ? color.from_gradient(hc, 0.0, 0.5, cLo, cMid) : color.from_gradient(hc, 0.5, 1.0, cMid, cHi)

// Score -> one continuous warm colour, interpolated across the 7 stops. No hard bands and
// no gray floor: a low score is a very light yellow (and mostly transparent), so it recedes
// without ever leaving the scale.
scoreCol(s) =>
    s < 15 ? color.from_gradient(s, 0, 15, colSc1, colSc2) :
     s < 30 ? color.from_gradient(s, 15, 30, colSc2, colSc3) :
     s < 45 ? color.from_gradient(s, 30, 45, colSc3, colSc4) :
     s < 60 ? color.from_gradient(s, 45, 60, colSc4, colSc5) :
     s < 75 ? color.from_gradient(s, 60, 75, colSc5, colSc6) :
     color.from_gradient(s, 75, 90, colSc6, colSc7)

// Heat (0-1) -> box transparency. Two even ramps that meet at the halfway point:
// heat 0->0.5 fades insigFade -> midT (faint -> muted), heat 0.5->1 goes midT -> darkT
// (muted -> solid). So the glaring solid color is RESERVED for heat >= 50; nothing
// below half-max ever hits full saturation, and the mid reads as a genuine mid.
opacityOf(hRaw) =>
    // Bend the raw magnitude first: everything is scaled to the session's single biggest
    // OI/GEX, so linearly one monster wall leaves every other box faint. heatCurve 0.5
    // (sqrt) lifts the mid-range — 25% of max reads as 50% intensity — so a genuinely
    // large-but-not-largest level still looks strong.
    h = math.pow(math.max(0.0, math.min(1.0, hRaw)), heatCurve)
    t = h < 0.5 ? insigFade - (h / 0.5) * (insigFade - midT) : midT - ((h - 0.5) / 0.5) * (midT - darkT)
    // fadeAll rides on top, symmetric and proportional, so brightening cannot invert the
    // ordering any more than fading can. Clamped because -80 on an already-solid box
    // would otherwise compute a negative transparency.
    math.max(0.0, math.min(100.0, t + (100.0 - t) * (fadeAll / 100.0)))

// NOTE: Pine labels have NO font-weight — there is no bold. Unicode bold glyphs render as
// TOFU in TradingView's label font (tried it). The heaviest look available is monospace
// (heavyFont) + high-contrast BLACK text on a COLORED box.

// =============================================================================
// THE COLUMN TABLE — the single source of truth for what a column IS.
// -----------------------------------------------------------------------------
// This is the whole point of the 6.8 rewrite. A column used to be defined in FIVE
// places that had to be kept in step by hand: its input, its field index, its colour,
// its block in the data loop, and its block in the header loop. Adding or changing one
// meant five coordinated edits, and the spacing constants appeared independently in the
// data loop AND the header loop — so the two could silently drift and the headers would
// stop sitting over their columns.
//
// Now a column is these six little functions, and BOTH loops read them. There is exactly
// one place to change, and the headers cannot disagree with the data because they are
// computed from the same numbers.
// =============================================================================
C_SCORE = 0
C_OI    = 1
C_GEX   = 2
C_DEX   = 3
C_SHARE = 4
C_VOL   = 5
C_AGE   = 6
NCOL    = 7

colKey(i) =>
    i == C_SCORE ? "score" : i == C_OI ? "oi" : i == C_GEX ? "gex" : i == C_DEX ? "dex" :
     i == C_SHARE ? "share" : i == C_VOL ? "vol" : "age"

colTitle(i) =>
    i == C_SCORE ? "SCORE" : i == C_OI ? "OI" : i == C_GEX ? "GEX" : i == C_DEX ? "DEX" :
     i == C_SHARE ? "%BD" : i == C_VOL ? "VOL" : "AGE"

colShow(i) =>
    i == C_SCORE ? showScore : i == C_OI ? showOi : i == C_GEX ? showGex : i == C_DEX ? showDex :
     i == C_SHARE ? showShare : i == C_VOL ? showVol : showAge

// Sideways correction as a FRACTION of bubbleGap, so it scales with the spacing slider.
// See SCORE_NUDGE / GEX_NUDGE above for why these two exist.
colNudge(i) =>
    i == C_SCORE ? SCORE_NUDGE : i == C_GEX ? GEX_NUDGE : 0.0

// Whole-bar correction — a fixed label-width effect, so it does NOT scale with spacing.
// Data bubbles only: the header chip is centred on its anchor, so it needs no bump.
colBump(i) =>
    i == C_SCORE ? SCORE_BUMP : 0

// How far the slot advances AFTER this column. %BD holds "16%" against OI/GEX's "-29.4M",
// so it gets a narrower lane rather than a nudge — see SHARE_SLOT.
colAdv(i) =>
    i == C_SHARE ? SHARE_SLOT : 1.0

// The draw order, resolved from the `colOrder` string into column ids.
//
// Deliberately forgiving: a key that is missing from the string keeps its default
// position at the end, and an unknown key is ignored. So a typo — or an older extension
// that writes nothing here at all — can never make a column vanish. The worst a bad
// string can do is leave the order alone.
drawOrder(spec) =>
    out  = array.new_int()
    seen = array.new_bool(NCOL, false)
    s    = str.lower(str.replace_all(spec, " ", ""))
    if str.length(s) > 0
        parts = str.split(s, ",")
        if array.size(parts) > 0
            for pi = 0 to array.size(parts) - 1
                k = array.get(parts, pi)
                idx = -1
                for cj = 0 to NCOL - 1
                    if colKey(cj) == k
                        idx := cj
                if idx >= 0 and not array.get(seen, idx)
                    array.set(seen, idx, true)
                    array.push(out, idx)
    for cz = 0 to NCOL - 1
        if not array.get(seen, cz)
            array.push(out, cz)
    out

// =============================================================================
// THE WIRE FORMAT — the single source of truth for which field is which.
// -----------------------------------------------------------------------------
// Seventeen positional fields used to be addressed by bare numbers scattered across a
// hundred lines (`array.size(f) > 12 ? ... : na`). Adding a field meant auditing every
// one of them. Now the numbers live here and nowhere else.
// =============================================================================
F_PRICE   = 0
F_TYPE    = 1
F_SCORE   = 2
F_OI      = 3
F_GEX     = 4
F_LINE    = 5
F_COLOR   = 6
F_OIHEAT  = 7
F_GEXHEAT = 8
F_AGECD   = 9
F_SHARE   = 10
F_VOL     = 11
F_SHHEAT  = 12
F_VOLHEAT = 13
F_DEX     = 14
F_DEXHEAT = 15
F_AGEMIN  = 16

// A field as text — "" when the feed is older than the field.
fTxt(f, i) =>
    array.size(f) > i ? array.get(f, i) : ""

// A field as a number — na when absent or empty, which every caller treats as
// "this feed predates the field" rather than as a zero.
fNum(f, i) =>
    array.size(f) > i and str.length(array.get(f, i)) > 0 ? str.tonumber(array.get(f, i)) : na

// A 0-100 heat field as a clamped 0-1 fraction, or na when absent.
fHeat(f, i) =>
    v = fNum(f, i)
    na(v) ? na : math.max(0.0, math.min(1.0, v / 100.0))

// Drawings persist across bars, so keep handles and clear them before redrawing —
// otherwise every new bar stacks another copy until the object cap is hit.
var line[]  lns = array.new_line()
var label[] lbs = array.new_label()

// Draw one bubble (own text + background color) and remember it for cleanup.
// Empty text draws nothing, so a missing column just leaves a gap.
drawBubble(int off, float price, string txt, color txtCol, color bgCol, string szName) =>
    if str.length(txt) > 0
        lb = label.new(bar_index + off, price, txt,
             style     = labelStyleOf(labelPosI),
             color     = bgCol,
             textcolor = txtCol,
             size      = sizeOf(szName),
             text_font_family = heavyFont ? font.family_monospace : font.family_default)
        array.push(lbs, lb)

// Headers: solid dark chip, light UPPERCASE text, and a STRAIGHT-DOWN tail
// (style_label_down) instead of the data bubbles' diagonal one. That style centres the
// chip on its anchor while the data anchors a corner, so `hdrShift` nudges it back over
// the column — Pine can't measure label width, so it's tuned by eye.
drawHeader(float off, float price, string txt) =>
    lb = label.new(bar_index + math.round(off), price, txt,
         style     = label.style_label_down,
         color     = colHdrBg,
         textcolor = colHdrTx,
         size      = sizeOf(effSz),
         text_font_family = heavyFont ? font.family_monospace : font.family_default)
    array.push(lbs, lb)

// PERF: the body used to re-run on EVERY realtime tick, deleting and recreating ~70
// labels each time — that is what triggered TradingView's "Heavy script / close to the
// 20s runtime limit" warning. Nothing here depends on price, only on the strings and the
// bar we anchor to, so redraw ONLY when one of those actually changes.
var string lastSrc   = na
var int    lastBar   = na
// gravData is written on its OWN cadence, so it has to be part of the change test.
// Without it, a gravity level that moved between bars would not appear until the next bar
// closed — up to five minutes of the chart showing a level Nexus had already replaced.
var string lastGrav  = na
// Same argument for the order: reordering the columns must repaint immediately, not at
// the next bar close.
var string lastOrder = na

if barstate.islast and (src != lastSrc or bar_index != lastBar or gravData != lastGrav or colOrder != lastOrder)
    lastSrc   := src
    lastBar   := bar_index
    lastGrav  := gravData
    lastOrder := colOrder
    // NOTE: guard the loops. In Pine `for i = 0 to -1` counts DOWN and executes,
    // so an unguarded loop over an empty array is a real bug, not a no-op.
    if array.size(lns) > 0
        for i = 0 to array.size(lns) - 1
            line.delete(array.get(lns, i))
        array.clear(lns)
    if array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.delete(array.get(lbs, i))
        array.clear(lbs)

    ord = drawOrder(colOrder)

    float maxP = na // track the top level so the title row can sit above it
    float minP = na

    // Pine has no str.trim, so strip every space up front.
    clean = str.replace_all(src, " ", "")
    if str.length(clean) > 0
        items = str.split(clean, ",")
        if array.size(items) > 0
            for i = 0 to array.size(items) - 1
                item = array.get(items, i)
                if str.length(item) > 0
                    f     = str.split(item, ":")
                    price = str.tonumber(array.get(f, F_PRICE))
                    if not na(price)
                        maxP := na(maxP) or price > maxP ? price : maxP
                        minP := na(minP) or price < minP ? price : minP

                        score  = fTxt(f, F_SCORE)
                        oi     = fTxt(f, F_OI)
                        gex    = fTxt(f, F_GEX)
                        dexTxt = fTxt(f, F_DEX)
                        volTxt = fTxt(f, F_VOL)
                        // F_LINE gates the dotted line: "0" = bubbles only, anything else
                        // (including absent, for hand-typed entries) = draw it. "2" means
                        // the extension found the card and the export disagreeing about
                        // the Gamma Flip, and this is the card's price — so it is drawn in
                        // its own colour. An older Pine simply reads "2" as "not 0" and
                        // draws an ordinary line, which is the right thing to degrade to.
                        lineFlag = array.size(f) > F_LINE ? array.get(f, F_LINE) : "1"
                        lineOn   = lineFlag != "0"
                        disputed = lineFlag == "2"

                        scoreNum = str.length(score) > 0 ? str.tonumber(score) : na
                        // Score drives the box's own darkness across the FULL range, so the
                        // highest-score levels end up the most solid instead of the gradient
                        // flattening out.
                        popFrac  = na(scoreNum) ? 0.0 : math.max(0.0, math.min(1.0, scoreNum / topScore))
                        // OI/GEX/DEX intensity is their OWN board-relative heat, so a monster
                        // GEX pops even on a low-score strike. Absent (older feed) falls back
                        // to the score-driven fraction.
                        oHeatV = fHeat(f, F_OIHEAT)
                        gHeatV = fHeat(f, F_GEXHEAT)
                        oHeat  = na(oHeatV) ? popFrac : oHeatV
                        gHeat  = na(gHeatV) ? popFrac : gHeatV
                        dHeatV = fHeat(f, F_DEXHEAT)
                        dHeat  = na(dHeatV) ? 0.0 : dHeatV
                        shareV = fNum(f, F_SHARE)
                        shHeatV = fHeat(f, F_SHHEAT)
                        // Share and volume are graded against the board exactly like OI and
                        // GEX. Before that, share scaled against a flat 100 (so a normal board
                        // never got past pale) and volume claimed no scale at all (so every
                        // strike printed one mid-tone and the column ranked nothing). Both
                        // still fall back to the old behaviour on an older feed.
                        shFrac  = na(shHeatV) ? (na(shareV) ? 0.0 : math.max(0.0, math.min(1.0, shareV / 100.0))) : shHeatV
                        volHeatV = fHeat(f, F_VOLHEAT)
                        vFrac   = na(volHeatV) ? 0.62 : volHeatV
                        ageCd   = fNum(f, F_AGECD)
                        ageMinV = fNum(f, F_AGEMIN)

                        // THE DURATION, NOT A LETTER YOU HAVE TO DECODE.
                        // N/S/E needed a legend every time; "45m" and "3.5h" do not, and they
                        // separate a level that just crossed two hours from one that has held
                        // all session — both of which used to print the same "E". The COLOUR
                        // still comes from the band, so the two can never disagree.
                        ageHrs  = na(ageMinV) ? na : ageMinV / 60.0
                        ageLong = na(ageMinV) ? "" : ageMinV < 60 ? str.tostring(math.round(ageMinV)) + "m" : str.tostring(math.round(ageHrs * 10) / 10, "#.#") + "h"
                        ageTxt  = na(ageCd) or ageCd < 1 ? "" : str.length(ageLong) > 0 ? ageLong : (ageCd >= 3 ? "E" : ageCd >= 2 ? "S" : "N")

                        // Score box HUE: below 30 is noise and stays GRAY (no hue at all).
                        // That is what makes the column glanceable — only levels that matter
                        // carry colour.
                        scoreHue = na(scoreNum) ? colGray : scoreCol(scoreNum)
                        ageHue   = na(ageCd) ? colGray : ageCd >= 3 ? color.green : ageCd >= 2 ? color.orange : colGray

                        // ---- one slot per column, filled by id --------------------------
                        txts = array.new_string(NCOL, "")
                        bgs  = array.new_color(NCOL, color.new(color.black, 100))
                        drks = array.new_bool(NCOL, false)

                        array.set(txts, C_SCORE, str.length(score) > 0 ? score : str.tostring(price, format.mintick))
                        array.set(bgs,  C_SCORE, color.new(scoreHue, opacityOf(popFrac)))
                        array.set(drks, C_SCORE, not na(scoreNum) and scoreNum >= 62)

                        array.set(txts, C_OI, oi)
                        array.set(bgs,  C_OI, color.new(signGrad(oi, oHeat), opacityOf(oHeat)))
                        array.set(drks, C_OI, oHeat >= 0.62)

                        array.set(txts, C_GEX, gex)
                        array.set(bgs,  C_GEX, color.new(signGrad(gex, gHeat), opacityOf(gHeat)))
                        array.set(drks, C_GEX, gHeat >= 0.62)

                        array.set(txts, C_DEX, dexTxt)
                        array.set(bgs,  C_DEX, color.new(signGrad(dexTxt, dHeat), opacityOf(dHeat)))
                        array.set(drks, C_DEX, dHeat >= 0.62)

                        array.set(txts, C_SHARE, na(shareV) ? "" : str.tostring(shareV) + "%")
                        array.set(bgs,  C_SHARE, color.new(color.teal, opacityOf(shFrac)))
                        array.set(drks, C_SHARE, shFrac >= 0.62)

                        array.set(txts, C_VOL, volTxt)
                        array.set(bgs,  C_VOL, color.new(signGrad(volTxt, vFrac), opacityOf(vFrac)))
                        array.set(drks, C_VOL, vFrac >= 0.62)

                        array.set(txts, C_AGE, ageTxt)
                        array.set(bgs,  C_AGE, color.new(ageHue, opacityOf(na(ageCd) ? 0.0 : ageCd / 3.0)))
                        array.set(drks, C_AGE, not na(ageCd) and ageCd >= 3)

                        // Line matches the score band colour (no Nexus blue/pink on lines) —
                        // except a disputed flip, which carries its own colour and is always
                        // DOTTED, so it reads as a different kind of statement even at a glance
                        // on a board where everything else is dashed.
                        lineCol = disputed
                             ? color.new(flipCol, math.max(0.0, math.min(100.0, 0 + 100.0 * (fadeAll / 100.0))))
                             : color.new(scoreHue, math.max(0.0, math.min(100.0, 8 + (100.0 - 8) * (fadeAll / 100.0))))
                        if lineOn and enabled
                            ln = line.new(bar_index - 1, price, bar_index, price,
                                 extend = spanFull ? extend.both : extend.none,
                                 color = lineCol,
                                 width = disputed ? math.max(lineWidth, 2) : lineWidth,
                                 style = disputed ? line.style_dotted : styleOf(lineStyleI))
                            array.push(lns, ln)

                        // ---- THE data loop. One block, any number of columns, any order.
                        // `slot` advances only for columns actually drawn, so turning one off
                        // closes its gap instead of leaving a blank lane. It is a float
                        // because %BD advances by a fraction; every offset is rounded at the
                        // point of use, since a bar offset must be an int.
                        if showLabels and enabled
                            slot = 0.0
                            for oi2 = 0 to NCOL - 1
                                ci = array.get(ord, oi2)
                                if colShow(ci)
                                    off = labelOff + math.round(slot * bubbleGap) + math.round(bubbleGap * colNudge(ci)) + colBump(ci)
                                    drawBubble(off, price, array.get(txts, ci), txtOn(array.get(drks, ci)), array.get(bgs, ci), effSz)
                                    slot += colAdv(ci)

    // ---- the header row, from the SAME table and the SAME order ---------------
    // It cannot drift from the data any more: both walk `ord` and both advance by
    // colAdv(). The only difference is colBump(), which the centred header chip does
    // not need — and that difference now lives in one named function instead of being
    // implicit in two hand-written blocks.
    if showTitle and enabled and not na(maxP)
        titleP = maxP + math.max((maxP - minP) * hdrGapPct / 100.0, maxP * 0.0008)
        hSlot = 0.0
        for oi2 = 0 to NCOL - 1
            ci = array.get(ord, oi2)
            if colShow(ci)
                drawHeader(labelOff + math.round(hSlot * bubbleGap) + hdrShift + math.round(bubbleGap * colNudge(ci)), titleP, colTitle(ci))
                hSlot += colAdv(ci)

    // ---- the gravity level ----------------------------------------------------
    //
    // Drawn from its own input rather than from the strike string, because it is read on
    // a different cadence and must survive a sync that didn't refresh it.
    if showGrav and str.length(gravData) > 0
        gf     = str.split(gravData, ":")
        gPrice = fNum(gf, 0)
        gProb  = fNum(gf, 2)
        gTgt   = fNum(gf, 3)
        gHeld  = fNum(gf, 4)
        if not na(gPrice)
            // DRAWN LAST, ON PURPOSE. Within one indicator TradingView paints in creation
            // order, so whatever is made last sits on top. Gravity is the one level here
            // that must never be buried, so the REACH marker is drawn first and gravity
            // goes over it — the reverse of the obvious reading order.
            //
            // Across indicators this is not enough: Nexus Futures draws thick wall bands
            // that will cover a line from another study regardless of what either script
            // does. That is a chart property, not a Pine one — fix it on the indicator's
            // legend row: More (...) > Visual order > Bring to front.
            if showReach and not na(gTgt) and gTgt != gPrice
                rLine = line.new(bar_index - 1, gTgt, bar_index, gTgt,
                     extend = extend.both, color = color.new(gravCol, 45), width = 1, style = line.style_dashed)
                array.push(lns, rLine)
                rLab = label.new(bar_index + gravLabOff, gTgt, "→ reach " + str.tostring(gTgt, format.mintick),
                     style     = label.style_label_left,
                     color     = color.new(gravCol, 45),
                     textcolor = color.white,
                     size      = sizeOf("Tiny"),
                     text_font_family = heavyFont ? font.family_monospace : font.family_default)
                array.push(lbs, rLab)
            gLine = line.new(bar_index - 1, gPrice, bar_index, gPrice,
                 extend = extend.both, color = gravCol, width = gravWidth, style = line.style_solid)
            array.push(lns, gLine)
            // THE ARROW POINTS AT THE REACH, NOT AT GRAVITY.
            //
            // It used to mean "which way price must move to reach the gravity level", which
            // is backwards for reading: gravity is where you already are looking, and the
            // reach candidate is where the model expects price to GO. With price at 732.5,
            // gravity 727 and reach 733, the old rule drew a down arrow on a level whose
            // target was above.
            //
            // So: up when the reach sits above gravity, down when below. With no reach to
            // point at, fall back to the price-relative meaning rather than guessing; and
            // when the reach IS this level there is no direction to give — the report's
            // "treat it as a magnet rather than a wall" case — so no arrow.
            // NO REACH, NO ARROW.
            //
            // The arrow means one thing: where the model expects price to GO. With a reach
            // candidate that is well defined — up when it sits above the gravity level,
            // down when below.
            //
            // With NO reach at all, there is no direction to report, and this used to
            // invent one anyway: it fell back to `gPrice > close`, which only says whether
            // the level happens to sit above or below the last trade. That is geometry the
            // label already shows — the price is right there next to it — dressed up as a
            // forecast. A dominant structure with no reach candidate is a magnet with no
            // stated pull, and the honest rendering of "we don't know" is nothing at all.
            // (Aidan, 2026-09-30: "if there's a dominant gravity structure and no reach, we
            // don't know direction... we shouldn't have an arrow.")
            //
            // Same for a reach that IS this level: no direction to give, so no arrow. That
            // case was already silent; this makes both behave the same way for one reason.
            gHasTgt = not na(gTgt) and gTgt != gPrice
            gUp     = gHasTgt and gTgt > gPrice
            gArrow  = gHasTgt ? (gUp ? "▲" : "▼") : ""
            gAge    = na(gHeld) ? "" : gHeld < 60 ? str.tostring(math.round(gHeld)) + "m" : str.tostring(math.round(gHeld / 6.0) / 10, "#.#") + "h"
            // ONE LINE. The classification (DOMINANT STRUCTURE / REACH CANDIDATE /
            // CONFLUENCE) was a second line under the price, which doubled the label's
            // height for a phrase that does not change what you do about the level. The
            // extension still reads it; it just is not worth two lines of chart.
            gTxt = (str.length(gArrow) > 0 ? gArrow + " " : "") + "GRAVITY " + str.tostring(gPrice, format.mintick) +
                 (na(gProb) ? "" : " · " + str.tostring(math.round(gProb)) + "%") +
                 (str.length(gAge) > 0 ? " · " + gAge : "")
            gLab = label.new(bar_index + gravLabOff, gPrice, gTxt,
                 style     = label.style_label_left,
                 color     = gravCol,
                 textcolor = color.white,
                 size      = sizeOf(effSz),
                 text_font_family = heavyFont ? font.family_monospace : font.family_default)
            array.push(lbs, gLab)
